{
  "version": 1,
  "sdk_version": "3.4.0",
  "path": "/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "quantum-coin-mcp",
      "version": "0.2.0",
      "title": "Quantum Coin MCP"
    },
    "tools": [
      {
        "name": "echo",
        "title": "Echo",
        "description": "Echo the input text back to the caller. Useful for verifying the MCP connection is working.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            }
          },
          "required": [
            "text"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "get_app_info",
        "title": "Get app info",
        "description": "Return a short description of this app (Quantum Coin) and a list of its main routes so an assistant can direct users to the right page.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "get_crypto_price",
        "title": "Get crypto price",
        "description": "Fetch the current USD price and 24h change for a cryptocurrency by CoinGecko id (e.g. 'bitcoin', 'ethereum', 'solana').",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": false,
          "openWorldHint": true
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "coinId": {
              "type": "string"
            }
          },
          "required": [
            "coinId"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "run_qrng",
        "title": "Quantum random number generator",
        "description": "Generate random bits by measuring Hadamard-prepared qubits on the native statevector engine. Returns the bitstring and its integer value.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "numBits": {
              "default": 32,
              "type": "number"
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "run_bb84_simulation",
        "title": "BB84 QKD simulation",
        "description": "Run a BB84 quantum key distribution simulation, optionally with an intercept-resend eavesdropper, and return the sifted key length and measured QBER.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "numBits": {
              "default": 256,
              "type": "number"
            },
            "simulateEavesdropper": {
              "default": false,
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "run_vqe",
        "title": "VQE ground state",
        "description": "Estimate the ground-state energy of a transverse-field Ising ring with a variational quantum eigensolver, using analytic parameter-shift gradients. Also reports the best unentangled ansatz for comparison.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "numQubits": {
              "default": 2,
              "type": "number"
            },
            "layers": {
              "default": 2,
              "type": "number"
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "run_qaoa",
        "title": "QAOA Max-Cut",
        "description": "Solve a Max-Cut instance with QAOA on the native engine and compare the sampled cut against the brute-force optimum.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "numNodes": {
              "default": 4,
              "type": "number"
            },
            "edges": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "u": {
                    "type": "number"
                  },
                  "v": {
                    "type": "number"
                  }
                },
                "required": [
                  "u",
                  "v"
                ]
              }
            },
            "depth": {
              "default": 2,
              "type": "number"
            }
          },
          "required": [
            "edges"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "check_blockchain_findings",
        "title": "Check on-chain findings (read-only)",
        "description": "Read recent on-chain events for the configured ProofOfNeuralWork contract through the read-only indexer. Reports `configured: false` honestly when no chain is configured instead of inventing findings. This tool cannot sign transactions or change contract state.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "blockWindow": {
              "default": 2000,
              "type": "number"
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      }
    ]
  }
}
